<Page x:Class="UP01_Savrasov_GasStation.Pages.AddPaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование чека" Height="600" Width="1000" Foreground="{DynamicResource TextColorBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Дата продажи" Margin="0,5"/>
            <DatePicker x:Name="DpDate" SelectedDate="{Binding Date}" Margin="0,0,0,10"/>

            <TextBlock Text="Итоговая сумма" Margin="0,5"/>
            <TextBox x:Name="TbPrice" Text="{Binding TotalAmount}" PreviewTextInput="TbNum_PreviewTextInput" Margin="0,0,0,10"/>

            <TextBlock Text="Сотрудник (Кассир)" Margin="0,5"/>
            <ComboBox x:Name="CbUser" DisplayMemberPath="FIO" SelectedValuePath="ID" SelectedValue="{Binding UserID}" Margin="0,0,0,10"/>

            <TextBlock Text="Способ оплаты" Margin="0,5"/>
            <ComboBox x:Name="CbPaymentMethod" DisplayMemberPath="Name" SelectedValuePath="ID" SelectedValue="{Binding PaymentMethodID}" Margin="0,0,0,20"/>

            <Button Content="Сохранить" Click="BtnSave_Click" Width="150" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>