<Page x:Class="UP01_Savrasov_GasStation.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель Администратора" Height="600" Width="1000" Foreground="{DynamicResource TextColorBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Панель управления АЗС" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            <Button Content="Сотрудники (Пользователи)" Width="300" Height="45" Click="BtnUsers_Click" Margin="0,10"/>
            <Button Content="История продаж (Платежи)" Width="300" Height="45" Click="BtnPayments_Click" Margin="0,10" Background="{DynamicResource SecondaryColorBrush}"/>
            <Button Content="Графики и Отчеты" Width="300" Height="45" Click="BtnDiagrams_Click" Margin="0,10" Background="{DynamicResource PrimaryColorBrush}"/>
        </StackPanel>
    </Grid>
</Page>