<Page x:Class="UP01_Savrasov_GasStation.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование пользователя" Height="600" Width="1000" Foreground="{DynamicResource TextColorBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Логин" Margin="0,5"/>
            <TextBox x:Name="TbLogin" Text="{Binding Login}" Margin="0,0,0,10"/>
            <TextBlock Text="Пароль (если меняем)" Margin="0,5"/>
            <TextBox x:Name="TbPassword" Text="{Binding Password}" Margin="0,0,0,10"/>
            <TextBlock Text="ФИО" Margin="0,5"/>
            <TextBox x:Name="TbFio" Text="{Binding FIO}" Margin="0,0,0,10"/>
            <TextBlock Text="Роль" Margin="0,5"/>
            <ComboBox x:Name="CbRole" SelectedValue="{Binding Role}" SelectedValuePath="Content" Margin="0,0,0,20">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="User"/>
            </ComboBox>
            <Button Content="Сохранить" Click="BtnSave_Click" Width="150" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>