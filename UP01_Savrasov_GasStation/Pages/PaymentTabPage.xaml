<Page x:Class="UP01_Savrasov_GasStation.Pages.PaymentTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История продаж" Height="600" Width="1000" Foreground="{DynamicResource TextColorBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DgPayments" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount}" Width="*"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding Users.FIO}" Width="*"/>
                <DataGridTextColumn Header="Способ оплаты" Binding="{Binding PaymentMethods.Name}" Width="*"/>
                <DataGridTemplateColumn Header="Действие" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редакт." Click="BtnEdit_Click" Width="60" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="Добавить" Click="BtnAdd_Click" Width="120"/>
            <Button Content="Удалить" Click="BtnDel_Click" Width="120" Background="{DynamicResource ErrorBrush}"/>
        </StackPanel>
    </Grid>
</Page>