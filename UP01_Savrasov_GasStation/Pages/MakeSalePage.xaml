<Page x:Class="UP01_Savrasov_GasStation.Pages.MakeSalePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Оформление чека" Height="600" Width="1000" Foreground="{DynamicResource TextColorBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оформление новой продажи" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Блок добавления товаров/услуг -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Топливо -->
            <TextBlock Text="Топливо:" VerticalAlignment="Center" Margin="0,0,10,10" Grid.Row="0" Grid.Column="0"/>
            <ComboBox x:Name="CbFuel" DisplayMemberPath="Name" Width="150" Margin="0,0,10,10" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Text="Кол-во (л):" VerticalAlignment="Center" Margin="0,0,10,10" Grid.Row="0" Grid.Column="2"/>
            <TextBox x:Name="TbFuelQty" Width="80" Margin="0,0,10,10" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" PreviewTextInput="NumberValidation"/>
            <Button Content="Добавить топливо" Click="BtnAddFuel_Click" Width="150" Background="{DynamicResource PrimaryColorBrush}" Grid.Row="0" Grid.Column="4"/>

            <!-- Услуги -->
            <TextBlock Text="Услуга/Товар:" VerticalAlignment="Center" Margin="0,10,10,0" Grid.Row="1" Grid.Column="0"/>
            <ComboBox x:Name="CbService" DisplayMemberPath="Name" Width="150" Margin="0,10,10,0" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Text="Кол-во (шт):" VerticalAlignment="Center" Margin="0,10,10,0" Grid.Row="1" Grid.Column="2"/>
            <TextBox x:Name="TbServiceQty" Width="80" Margin="0,10,10,0" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" PreviewTextInput="NumberValidation"/>
            <Button Content="Добавить услугу" Click="BtnAddService_Click" Width="150" Background="{DynamicResource PrimaryColorBrush}" Grid.Row="1" Grid.Column="4"/>
        </Grid>

        <!-- Корзина (DataGrid) -->
        <DataGrid x:Name="DgCart" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Цена за ед." Binding="{Binding Price}" Width="150"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="150"/>
                <DataGridTextColumn Header="Итого" Binding="{Binding Total}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Итог и оплата -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Способ оплаты:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CbPaymentMethod" DisplayMemberPath="Name" Width="150" Margin="0,0,20,0"/>

            <TextBlock Text="ИТОГО К ОПЛАТЕ:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="TbTotalAmount" Text="0.00 руб." FontSize="18" Foreground="Green" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

            <Button Content="Провести оплату" Click="BtnCheckout_Click" Width="180" Background="{DynamicResource PrimaryColorBrush}"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Width="100" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextColorBrush}"/>
        </StackPanel>
    </Grid>
</Page>