<Page x:Class="UP01_Savrasov_GasStation.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля" Height="600" Width="1000" Foreground="{DynamicResource TextColorBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="Смена пароля" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Логин с плейсхолдером -->
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,5">
            <TextBox x:Name="TbLogin" TextChanged="TbLogin_TextChanged" ToolTip="Введите ваш логин"/>
            <TextBlock x:Name="LblLoginPh" Text="Введите логин" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" MouseLeftButtonUp="LblLoginPh_MouseLeftButtonUp"/>
        </Grid>

        <!-- Старый пароль с плейсхолдером -->
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,5">
            <PasswordBox x:Name="PbOldPass" PasswordChanged="PbOldPass_PasswordChanged" ToolTip="Введите старый пароль"/>
            <TextBlock x:Name="LblOldPassPh" Text="Старый пароль" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" MouseLeftButtonUp="LblOldPassPh_MouseLeftButtonUp"/>
        </Grid>

        <!-- Новый пароль с плейсхолдером -->
        <Grid Grid.Row="4" Grid.Column="1" Margin="0,5">
            <PasswordBox x:Name="PbNewPass" PasswordChanged="PbNewPass_PasswordChanged" ToolTip="Новый пароль (мин 6 символов, англ, хотя бы 1 цифра)"/>
            <TextBlock x:Name="LblNewPassPh" Text="Новый пароль" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" MouseLeftButtonUp="LblNewPassPh_MouseLeftButtonUp"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Сменить" Click="BtnChange_Click" Width="150"/>
            <Button Content="Назад" Click="BtnBack_Click" Width="100" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextColorBrush}"/>
        </StackPanel>
    </Grid>
</Page>