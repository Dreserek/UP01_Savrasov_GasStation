<Page x:Class="UP01_Savrasov_GasStation.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация" Height="600" Width="1000" Foreground="{DynamicResource TextColorBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblTitle" Grid.Row="1" Grid.Column="1" Text="Вход в систему АЗС" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel x:Name="LoginPanel" Grid.Row="2" Grid.Column="1">
            <!-- Логин с плейсхолдером -->
            <Grid Margin="0,5">
                <TextBox x:Name="TbLogin" TextChanged="TbLogin_TextChanged" ToolTip="Введите логин"/>
                <TextBlock x:Name="LblLoginPlaceholder" Text="Введите логин" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" MouseLeftButtonUp="LblLoginPlaceholder_MouseLeftButtonUp"/>
            </Grid>

            <!-- Пароль с плейсхолдером -->
            <Grid Margin="0,5">
                <PasswordBox x:Name="PbPassword" PasswordChanged="PbPassword_PasswordChanged" ToolTip="Введите пароль"/>
                <TextBlock x:Name="LblPassPlaceholder" Text="Введите пароль" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" MouseLeftButtonUp="LblPassPlaceholder_MouseLeftButtonUp"/>
            </Grid>

            <Button x:Name="BtnLogin" Content="Вход" Click="BtnLogin_Click" HorizontalAlignment="Center" Margin="0,15,0,5"/>
            <Button x:Name="BtnRegister" Content="Регистрация" Click="BtnRegister_Click" Background="{DynamicResource SecondaryColorBrush}" HorizontalAlignment="Center" Margin="0,5"/>
            <Button x:Name="BtnChangePass" Content="Сменить пароль" Click="BtnChangePass_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextColorBrush}" HorizontalAlignment="Center" Margin="0,5"/>
        </StackPanel>

        <StackPanel x:Name="CaptchaPanel" Grid.Row="2" Grid.Column="1" Visibility="Hidden">
            <TextBox x:Name="TbCaptchaText" IsReadOnly="True" Background="{DynamicResource SurfaceBrush}" FontStyle="Italic" FontWeight="Bold" FontSize="20" Foreground="Red" HorizontalContentAlignment="Center" Height="40" CommandManager.PreviewExecuted="TbCaptchaText_PreviewExecuted" ContextMenu="{x:Null}"/>
            <TextBox x:Name="TbCaptchaInput" ToolTip="Введите символы" Margin="0,10,0,0" Height="35"/>
            <Button x:Name="BtnSubmitCaptcha" Content="Подтвердить" Click="BtnSubmitCaptcha_Click" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>