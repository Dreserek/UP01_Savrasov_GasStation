<Page x:Class="UP01_Savrasov_GasStation.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация" Height="600" Width="1000" Foreground="{DynamicResource TextColorBrush}">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="Регистрация" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="2" Grid.Column="1" Margin="0,5">
            <TextBox x:Name="TbRegLogin" TextChanged="TbRegLogin_TextChanged" ToolTip="Логин (латиница)"/>
            <TextBlock x:Name="LblRegLoginPh" Text="Введите логин" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" MouseLeftButtonUp="LblRegLoginPh_MouseLeftButtonUp"/>
        </Grid>

        <Grid Grid.Row="3" Grid.Column="1" Margin="0,5">
            <TextBox x:Name="TbRegFio" TextChanged="TbRegFio_TextChanged" ToolTip="ФИО"/>
            <TextBlock x:Name="LblRegFioPh" Text="Введите ФИО" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" MouseLeftButtonUp="LblRegFioPh_MouseLeftButtonUp"/>
        </Grid>

        <Grid Grid.Row="4" Grid.Column="1" Margin="0,5">
            <PasswordBox x:Name="PbRegPass1" PasswordChanged="PbRegPass1_PasswordChanged" ToolTip="Пароль (мин 6 символов, англ, хотя бы 1 цифра)"/>
            <TextBlock x:Name="LblRegPass1Ph" Text="Пароль" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" MouseLeftButtonUp="LblRegPass1Ph_MouseLeftButtonUp"/>
        </Grid>

        <Grid Grid.Row="5" Grid.Column="1" Margin="0,5">
            <PasswordBox x:Name="PbRegPass2" PasswordChanged="PbRegPass2_PasswordChanged" ToolTip="Повторите пароль"/>
            <TextBlock x:Name="LblRegPass2Ph" Text="Повторите пароль" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" MouseLeftButtonUp="LblRegPass2Ph_MouseLeftButtonUp"/>
        </Grid>

        <ComboBox x:Name="CbRole" Grid.Row="6" Grid.Column="1" Margin="0,5" SelectedIndex="1">
            <ComboBoxItem Content="Admin"/>
            <ComboBoxItem Content="User"/>
        </ComboBox>

        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Зарегистрироваться" Click="BtnDoRegister_Click" Width="180"/>
            <Button Content="Назад" Click="BtnBack_Click" Width="100" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextColorBrush}"/>
        </StackPanel>
    </Grid>
</Page>